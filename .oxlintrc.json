{
  "plugins": ["typescript", "import"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "no-restricted-imports": ["error", { "patterns": ["../*"] }]
  },
  "ignorePatterns": ["dist", "node_modules"]
}
